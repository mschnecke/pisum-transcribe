<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <PackageVersion Include="Avalonia" Version="12.1.1" />
        <!-- Not used: referenced with ExcludeAssets="all", so NuGet imports none of its targets and no build runs
             Avalonia's build telemetry (AvaloniaStats), which the package offers no MSBuild property to turn off. Keep
             the version Avalonia depends on; a newer one there fails the build with NU1605. -->
        <PackageVersion Include="Avalonia.BuildServices" Version="11.3.2" />
        <PackageVersion Include="Avalonia.HarfBuzz" Version="12.1.1" />
        <PackageVersion Include="Avalonia.Native" Version="12.1.1" />
        <PackageVersion Include="Avalonia.Skia" Version="12.1.1" />
        <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
        <PackageVersion Include="Avalonia.Win32" Version="12.1.1" />
        <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
        <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
        <!-- Exact pin: a unit test asserts the loaded runtime version, which must not be the Windows ML copy in System32.
             When the pin changes, refresh packaging/third-party/onnxruntime-ThirdPartyNotices.txt from the new package's ThirdPartyNotices.txt.
             Its libonnxruntime.dylib sets the minimum macOS (14.0 for 1.30.0): when the pin changes, read its minos with
             `otool -l libonnxruntime.dylib | grep minos` and raise LSMinimumSystemVersion and the Swift helper's target
             with it (design D1 of add-macos-shell). -->
        <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="[1.30.0]" />
        <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.333" />
        <!-- Exact pin: NuGet lists an unrelated 22.0.0 that a floating range would pick up. -->
        <PackageVersion Include="NAudio.Wasapi" Version="[3.1.0]" />
        <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
        <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
        <!-- When the pin changes, update the libuiohook commit, the one SharpHook's tag points its submodule at,
             in THIRD-PARTY-NOTICES.md and .github/workflows/release.yml. -->
        <PackageVersion Include="SharpHook" Version="[8.0.0]" />
        <!-- Exact pins: the wrapper binds one transcribe.cpp 0.x ABI. -->
        <PackageVersion Include="TranscribeCppSharp" Version="[0.2.0]" />
        <PackageVersion Include="TranscribeCppSharp.Native.win-x64" Version="[0.2.3]" />
        <PackageVersion Include="TranscribeCppSharp.Native.osx-arm64" Version="[0.2.3]" />
    </ItemGroup>

    <ItemGroup Label="Tests">
        <PackageVersion Include="Avalonia.Headless" Version="12.1.1" />
        <PackageVersion Include="FakeItEasy" Version="9.0.1" />
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
        <PackageVersion Include="SharpHook.Testing" Version="[8.0.0]" />
        <PackageVersion Include="Shouldly" Version="4.3.0" />
        <PackageVersion Include="xunit.v3" Version="4.0.1" />
    </ItemGroup>

    <ItemGroup Label="Tools">
        <PackageVersion Include="SkiaSharp" Version="4.152.1" />
        <PackageVersion Include="Svg.Skia" Version="5.2.3" />
    </ItemGroup>
</Project>
