<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Only the host's framework, so `dotnet test` stays one command on each machine (design D2 of add-macos-shell). -->
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(PisumWindowsTargetFramework)</TargetFramework>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">$(PisumMacTargetFramework)</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- The Win32 test helpers call the app's generated PInvoke, whose global memory functions return pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless"/>
    <!-- Turns off Avalonia's build telemetry, which Avalonia.Headless pulls in again (see Directory.Packages.props). -->
    <PackageReference Include="Avalonia.BuildServices" ExcludeAssets="all" PrivateAssets="all"/>
    <PackageReference Include="FakeItEasy"/>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing"/>
    <PackageReference Include="SharpHook.Testing"/>
    <PackageReference Include="Shouldly"/>
    <PackageReference Include="xunit.v3"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="FakeItEasy"/>
    <Using Include="Shouldly"/>
    <Using Include="Xunit"/>
  </ItemGroup>

  <!-- Platform folders, as in the app: Windows/ only for Windows, and MacOS/ only for macOS. -->
  <ItemGroup Condition="'$(TargetFramework)' == '$(PisumWindowsTargetFramework)'">
    <Compile Remove="**\MacOS\**"/>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == '$(PisumMacTargetFramework)'">
    <Compile Remove="**\Windows\**"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pisum.Transcribe\Pisum.Transcribe.csproj"/>
  </ItemGroup>
</Project>
