<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Product>Pisum Transcribe</Product>
    <StartupObject>Pisum.Transcribe.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Also the icon of every window without its own, such as the settings dialog: WPF falls back to the exe icon. -->
    <ApplicationIcon>Tray\TrayIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm"/>
    <PackageReference Include="H.NotifyIcon.Wpf"/>
    <PackageReference Include="Microsoft.Extensions.Hosting"/>
    <PackageReference Include="Microsoft.Extensions.Http"/>
    <PackageReference Include="Microsoft.ML.OnnxRuntime"/>
    <!-- Build-time source generator for the Win32 calls listed in NativeMethods.txt. -->
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all"/>
    <PackageReference Include="NAudio.Wasapi"/>
    <PackageReference Include="Serilog.Extensions.Hosting"/>
    <PackageReference Include="Serilog.Sinks.File"/>
    <PackageReference Include="SharpHook"/>
    <PackageReference Include="TranscribeCppSharp"/>
    <PackageReference Include="TranscribeCppSharp.Native.win-x64"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pisum.Transcribe.Tests"/>
    <!-- Lets FakeItEasy fake internal types. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2"/>
  </ItemGroup>

  <ItemGroup>
    <!-- A Page instead of an ApplicationDefinition, so WPF generates no second Main next to Program.Main. -->
    <ApplicationDefinition Remove="App.xaml"/>
    <Page Include="App.xaml"/>
    <EmbeddedResource Include="Tray\TrayIcon.ico"/>
    <None Include="VoiceActivity\Assets\silero_vad.onnx" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
