<Window x:Class="Pisum.Transcribe.Dictation.RecordingOverlayWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pisum Transcribe"
        Width="220"
        Height="44"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        Focusable="False"
        IsHitTestVisible="False">
    <Border CornerRadius="22"
            Background="#E6202124"
            BorderBrush="#40FFFFFF"
            BorderThickness="1">
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Ellipse x:Name="Dot"
                     Width="12"
                     Height="12"
                     VerticalAlignment="Center" />
            <Grid x:Name="Spinner"
                  Width="16"
                  Height="16"
                  VerticalAlignment="Center"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <RotateTransform x:Name="SpinnerRotation" />
                </Grid.RenderTransform>
                <Ellipse Stroke="#40FFFFFF"
                         StrokeThickness="2" />
                <Ellipse Stroke="#FFFFB300"
                         StrokeThickness="2"
                         StrokeDashArray="10 100" />
            </Grid>
            <TextBlock x:Name="Label"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       FontFamily="Segoe UI"
                       FontSize="14"
                       Foreground="White" />
        </StackPanel>
    </Border>
</Window>
