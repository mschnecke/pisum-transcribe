<Window x:Class="Pisum.Transcribe.Dictation.RecordingOverlayWindow"
        x:ClassModifier="internal"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pisum Transcribe"
        Width="220"
        Height="44"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        CanResize="False"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        Focusable="False"
        IsHitTestVisible="False">
    <Window.Styles>
        <!-- The spinner turns once a second while it has the class. -->
        <Style Selector="Grid#Spinner.spinning">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>
    <Border CornerRadius="22"
            Background="#E6202124"
            BorderBrush="#40FFFFFF"
            BorderThickness="1">
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Ellipse x:Name="Dot"
                     Width="12"
                     Height="12"
                     VerticalAlignment="Center" />
            <Grid x:Name="Spinner"
                  Width="16"
                  Height="16"
                  VerticalAlignment="Center"
                  RenderTransformOrigin="0.5,0.5">
                <Ellipse Stroke="#40FFFFFF"
                         StrokeThickness="2" />
                <Ellipse Stroke="#FFFFB300"
                         StrokeThickness="2"
                         StrokeDashArray="10,100" />
            </Grid>
            <TextBlock x:Name="Label"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       FontFamily="Segoe UI"
                       FontSize="14"
                       Foreground="White" />
        </StackPanel>
    </Border>
</Window>
