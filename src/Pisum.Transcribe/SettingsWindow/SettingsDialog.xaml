<Window x:Class="Pisum.Transcribe.SettingsWindow.SettingsDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pisum Transcribe Settings"
        ResizeMode="CanMinimize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <!-- Shows a message in red and hides the line while there is none. -->
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Firebrick" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RadioOption" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,2,0,2" />
        </Style>
    </Window.Resources>

    <!-- A fixed size that shows every section without scrolling (see SettingsDialogTests), also with downloads running
         in the model section, and fits a 1280 × 800 screen (1920 × 1200 at 150 %). -->
    <Grid Width="868" Height="568" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox x:Name="Navigation" Grid.Row="0" Grid.Column="0" SelectedIndex="0"
                 AutomationProperties.Name="Sections">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="8,6" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBoxItem Content="Dictation" />
            <ListBoxItem Content="Model" />
            <ListBoxItem Content="Engine" />
            <ListBoxItem Content="Text insertion" />
            <ListBoxItem Content="General" />
        </ListBox>

        <ScrollViewer x:Name="SectionContent" Grid.Row="0" Grid.Column="1" Margin="16,0,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <!-- Dictation -->
                <StackPanel DataContext="{Binding Dictation}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=Navigation}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Dictation" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Push-to-talk hotkey" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="C_hange…"
                                Command="{Binding ChangeHotkeyCommand}" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding HotkeyName}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Visibility="{Binding IsRecordingHotkey, Converter={StaticResource BooleanToVisibility}}"
                               Text="Hold the new key combination, then release it. Press Esc to cancel." />
                    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding HotkeyError}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Task" />
                    <RadioButton Style="{StaticResource RadioOption}" GroupName="Task"
                                 Content="_Translate into another language" IsChecked="{Binding IsTranslate}" />
                    <RadioButton Style="{StaticResource RadioOption}" GroupName="Task"
                                 Content="T_ranscribe in the spoken language" IsChecked="{Binding IsTranscribe}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Spoken language" />
                    <ComboBox ItemsSource="{Binding SourceOptions}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedSource}"
                              AutomationProperties.Name="Spoken language" />
                    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding SourceLanguageError}" />

                    <StackPanel Visibility="{Binding IsTranslate, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Translate into" />
                        <ComboBox ItemsSource="{Binding TargetOptions}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedTarget}"
                                  AutomationProperties.Name="Translate into" />
                        <TextBlock Style="{StaticResource ErrorText}" Text="{Binding TargetLanguageError}" />
                    </StackPanel>

                    <CheckBox Margin="0,16,0,0" Content="Tri_m silence before transcription"
                              IsChecked="{Binding TrimSilence}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Cuts the silence before and after your speech. Recordings without speech are not transcribed." />
                </StackPanel>

                <!-- Model -->
                <StackPanel DataContext="{Binding Model}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=Navigation}" Value="1">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Speech model" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                               Text="Select an installed model to use it. Downloads and deletes take effect at once." />

                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="8" BorderThickness="1"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                                    <StackPanel>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                        VerticalAlignment="Top">
                                                <Button Content="Download" Command="{Binding DownloadCommand}"
                                                        AutomationProperties.Name="{Binding Model.DisplayName, StringFormat='Download {0}'}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource DialogButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Download.IsDownloading}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Style="{StaticResource DialogButton}" Content="Cancel"
                                                        Command="{Binding CancelDownloadCommand}"
                                                        Visibility="{Binding Download.IsDownloading, Converter={StaticResource BooleanToVisibility}}"
                                                        AutomationProperties.Name="{Binding Model.DisplayName, StringFormat='Cancel the download of {0}'}" />
                                                <Button Style="{StaticResource DialogButton}" Content="Delete"
                                                        Command="{Binding DeleteCommand}"
                                                        Visibility="{Binding ShowsDelete, Converter={StaticResource BooleanToVisibility}}"
                                                        AutomationProperties.Name="{Binding Model.DisplayName, StringFormat='Delete {0}'}" />
                                            </StackPanel>
                                            <RadioButton GroupName="Model" IsChecked="{Binding IsSelected}"
                                                         IsEnabled="{Binding IsInstalled}"
                                                         AutomationProperties.Name="{Binding Model.DisplayName}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Model.DisplayName}" />
                                                    <TextBlock Margin="8,0,0,0" Text="(active)"
                                                               Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibility}}" />
                                                </StackPanel>
                                            </RadioButton>
                                        </DockPanel>

                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                            <TextBlock>
                                                <Run Text="Download size:" /> <Run Text="{Binding Option.SizeText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text=" · " />
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Not installed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                <Setter Property="Text" Value="Installed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="Languages:" /> <Run Text="{Binding Option.LanguagesText, Mode=OneWay}" />
                                        </TextBlock>

                                        <StackPanel Margin="0,4,0,0"
                                                    Visibility="{Binding Download.IsDownloading, Converter={StaticResource BooleanToVisibility}}">
                                            <ProgressBar Height="12" Maximum="100"
                                                         Value="{Binding Download.ProgressPercent, Mode=OneWay}" />
                                            <TextBlock Margin="0,2,0,0" Text="{Binding Download.ProgressText}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Download.ErrorMessage}" />
                                        <TextBlock Style="{StaticResource ErrorText}" Text="{Binding DeleteError}" />

                                        <!-- A line break between two elements shows as a space, so keep the comma and period attached. -->
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0">
                                            <Run Text="Created by" />
                                            <Run Text="{Binding Model.Creator, Mode=OneWay}" /><Run Text=", licensed under" />
                                            <Hyperlink NavigateUri="{Binding Model.LicenseUrl}"
                                                       RequestNavigate="OnRequestNavigate">
                                                <Run Text="{Binding Model.LicenseName, Mode=OneWay}" />
                                            </Hyperlink><Run Text="." />
                                            <Run Text="Changes:" /> <Run Text="{Binding Model.Changes, Mode=OneWay}" /><Run Text="." />
                                            <Run Text="Source:" /> <Run Text="{Binding Model.SourceRepository, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Engine: the backend belongs to the model section's view model. -->
                <StackPanel DataContext="{Binding Model}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=Navigation}" Value="2">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Engine" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Compute backend" />
                    <RadioButton Style="{StaticResource RadioOption}" GroupName="Backend"
                                 Content="_Auto: the GPU when it works, otherwise the CPU"
                                 IsChecked="{Binding IsAutoBackend}" />
                    <RadioButton Style="{StaticResource RadioOption}" GroupName="Backend"
                                 Content="_Vulkan (GPU) only" IsChecked="{Binding IsVulkanBackend}" />
                    <RadioButton Style="{StaticResource RadioOption}" GroupName="Backend"
                                 Content="C_PU only" IsChecked="{Binding IsCpuBackend}" />
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                        <Run Text="Status:" /> <Run Text="{Binding EngineStatusText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <!-- Text insertion -->
                <StackPanel DataContext="{Binding TextInsertion}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=Navigation}" Value="3">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Text insertion" />
                    <RadioButton Style="{StaticResource RadioOption}" GroupName="Insertion"
                                 Content="_Paste via clipboard" IsChecked="{Binding IsClipboardPaste}" />
                    <CheckBox Margin="20,2,0,2" Content="_Restore clipboard after paste"
                              IsChecked="{Binding RestoreClipboard}" IsEnabled="{Binding CanRestoreClipboard}" />
                    <RadioButton Style="{StaticResource RadioOption}" GroupName="Insertion"
                                 Content="T_ype text" IsChecked="{Binding IsTypeText}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Typing leaves the clipboard alone but is slower for long text." />
                </StackPanel>

                <!-- General -->
                <StackPanel DataContext="{Binding General}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=Navigation}" Value="4">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="General" />
                    <CheckBox Content="Start with _Windows" IsChecked="{Binding StartWithWindows}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Starts Pisum Transcribe when you sign in to Windows. Applies to your user account only." />

                    <CheckBox Margin="0,16,0,0" Content="Check for _updates automatically"
                              IsChecked="{Binding CheckForUpdates}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Asks GitHub once a day whether a new version of Pisum Transcribe exists. Nothing else is sent." />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource ErrorText}"
                   Margin="0,12,0,0" Text="{Binding SaveError}" />

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,16,0,0"
                    HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Style="{StaticResource DialogButton}" IsDefault="True" Content="_Save"
                    Command="{Binding SaveCommand}" />
            <Button Style="{StaticResource DialogButton}" IsCancel="True" Content="_Close" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
