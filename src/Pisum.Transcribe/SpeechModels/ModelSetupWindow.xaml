<Window x:Class="Pisum.Transcribe.SpeechModels.ModelSetupWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pisum Transcribe"
        Width="560"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Download a speech model" />
        <TextBlock Margin="0,4,0,12" TextWrapping="Wrap"
                   Text="Pisum Transcribe needs a speech model before you can dictate. Choose a model and download it. The model runs on this computer." />

        <ListBox ItemsSource="{Binding Models}"
                 SelectedItem="{Binding SelectedModel}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Style>
                <Style TargetType="ListBox">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Style>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <!-- Otherwise screen readers read the item's ToString(). -->
                    <Setter Property="AutomationProperties.Name" Value="{Binding Model.DisplayName}" />
                    <Setter Property="Padding" Value="8,6" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- The list item handles clicks and keys; the radio button only shows the selection. -->
                    <RadioButton
                        IsChecked="{Binding IsSelected, Mode=OneWay, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                        IsHitTestVisible="False"
                        Focusable="False">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{Binding Model.DisplayName}" />
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="Download size:" /> <Run Text="{Binding SizeText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="Languages:" /> <Run Text="{Binding LanguagesText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </RadioButton>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <GroupBox Margin="0,12,0,0" Header="License">
            <StackPanel Margin="4">
                <!-- A line break between two elements shows as a space, so keep the comma and period attached. -->
                <TextBlock TextWrapping="Wrap">
                    <Run Text="Created by" />
                    <Run Text="{Binding SelectedModel.Model.Creator, Mode=OneWay}" /><Run Text=", licensed under" />
                    <Hyperlink NavigateUri="{Binding SelectedModel.Model.LicenseUrl}"
                               RequestNavigate="OnRequestNavigate">
                        <Run Text="{Binding SelectedModel.Model.LicenseName, Mode=OneWay}" />
                    </Hyperlink>
                    <Run Text="." />
                </TextBlock>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                    <Run Text="Changes:" /> <Run Text="{Binding SelectedModel.Model.Changes, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                    <Run Text="Source:" /> <Run Text="{Binding SelectedModel.Model.SourceRepository, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </GroupBox>

        <StackPanel Margin="0,12,0,0"
                    Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibility}}">
            <ProgressBar Height="16" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" />
            <TextBlock Margin="0,4,0,0" Text="{Binding ProgressText}" />
        </StackPanel>

        <DockPanel Margin="0,12,0,0"
                   Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}">
            <Button DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource DialogButton}"
                    Content="_Retry" Command="{Binding RetryCommand}" />
            <TextBlock Foreground="Firebrick" TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
        </DockPanel>

        <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Style="{StaticResource DialogButton}" IsDefault="True"
                    Content="_Download" Command="{Binding DownloadCommand}" />
            <Button Style="{StaticResource DialogButton}"
                    Content="_Cancel" Command="{Binding CancelCommand}" />
            <Button Style="{StaticResource DialogButton}" IsCancel="True"
                    Content="C_lose" Command="{Binding CloseCommand}" />
        </StackPanel>
    </StackPanel>
</Window>